[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,sln}]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

[*.{received,verified}.{cs,txt}]
charset = utf-8-bom
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false
