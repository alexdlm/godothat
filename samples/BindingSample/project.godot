; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotHat Binding Sample"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")

[autoload]

Services="*res://Services/ServicesAutoload.cs"

[editor_plugins]

enabled=PackedStringArray("res://addons/godothat_binding/plugin.cfg")

[dotnet]

project/assembly_name="BindingSample"
