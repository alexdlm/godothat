<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <config>
        <!-- Locally packed nupkgs are always 0.0.0-local, keep them out of the shared cache so they're never stale -->
        <add key="globalPackagesFolder" value=".packages" />
    </config>
    <packageSources>
        <clear />
        <add key="local" value="../nupkgs" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="local">
            <package pattern="GodotHat.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
